# Node
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL
POSTGRES_USER=dns
POSTGRES_PASSWORD=dns_dev
POSTGRES_DB=dns_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dns:dns_dev@localhost:5432/dns_dev

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# APIs — two separate services over the same database (see docs/adr/0002-*.md).
# The admin service carries no /admin path prefix; the port distinguishes them.
CLIENT_API_PORT=3000
ADMIN_API_PORT=3001

# JWT — client API (mobile users)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d

# JWT — admin API (staff). Deliberately different secrets: a client token must
# never verify against the admin service (see docs/adr/0003-*.md).
ADMIN_JWT_SECRET=change-me-admin-secret-in-production
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_SECRET=change-me-admin-refresh-secret-in-production
ADMIN_JWT_REFRESH_EXPIRES_IN=30d

# ── First admin account ─────────────────────────────────────────────────
# Read ONLY by `pnpm db:seed:admin`, which creates a SUPER_ADMIN once per
# environment. The panel has no sign-up, so without this a fresh database has
# a login form and nobody able to use it.
#
# Idempotent: if the address already exists the row is left completely alone
# and the password is NOT reset — re-running a seed must never be a way to
# take over an account. Minimum 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In (https://developer.apple.com)
APPLE_CLIENT_ID=com.rationfit.application

# OTP — fixed code for dev/testing; leave empty to generate random codes.
# TTL (10 min) and the 5-attempt cap are policy, not deployment config —
# they live in @dns/constants.
OTP_DEV_CODE=000000

# Email — Resend (https://resend.com). Leave the key empty and the API falls
# back to a stub client that logs the message instead of sending it.
RESEND_API_KEY=
EMAIL_FROM=noreply@rationfit.app

# Throttler (rate limiting) — global default
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Per-route throttle rules (override the global default)
THROTTLE_LOGIN_TTL=900000
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REGISTER_TTL=3600000
THROTTLE_REGISTER_LIMIT=5
THROTTLE_REFRESH_TOKEN_TTL=60000
THROTTLE_REFRESH_TOKEN_LIMIT=10
THROTTLE_SEND_OTP_TTL=3600000
THROTTLE_SEND_OTP_LIMIT=5
THROTTLE_VERIFY_OTP_TTL=900000
THROTTLE_VERIFY_OTP_LIMIT=10
THROTTLE_PASSWORD_RESET_TTL=3600000
THROTTLE_PASSWORD_RESET_LIMIT=5
THROTTLE_OAUTH_GOOGLE_TTL=60000
THROTTLE_OAUTH_GOOGLE_LIMIT=5
THROTTLE_OAUTH_APPLE_TTL=60000
THROTTLE_OAUTH_APPLE_LIMIT=5
THROTTLE_FILE_UPLOAD_PRESIGN_TTL=60000
THROTTLE_FILE_UPLOAD_PRESIGN_LIMIT=30

# S3 / MinIO storage
# Internal endpoint the API uses to sign URLs and (optionally) hit the S3 API.
# Local dev: http://localhost:9100  — Server w/ compose networking: http://minio:9000
S3_ENDPOINT=http://localhost:9100
# Public base URL clients use to upload/download.
S3_PUBLIC_URL=http://localhost:9100
S3_BUCKET=dns-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_admin_change_me
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL=900
S3_MAX_FILE_SIZE=26214400
S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Store purchases (App Store / Google Play)
# Leave empty and the server accepts receipts at face value, logging a warning —
# the same arrangement as an empty RESEND_API_KEY. Fill them before release.
APPLE_BUNDLE_ID=com.rationfit.application
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PACKAGE_NAME=com.rationfit.application
GOOGLE_SERVICE_ACCOUNT_JSON=

# MinIO (docker-compose only; API uses S3_* above)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_change_me
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BROWSER_REDIRECT_URL=http://localhost:9101

# Clients
# Web admin panel talks to the admin API, mobile talks to the client API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
