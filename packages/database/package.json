{
    "name": "@dns/database",
    "version": "0.0.1",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "test": "tsx --test \"src/**/*.test.ts\"",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "tsx src/migrate.ts",
        "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "db:seed": "tsx src/seeds/seed.ts"
    },
    "dependencies": {
        "@dns/shared-types": "workspace:*",
        "drizzle-orm": "0.45.2",
        "postgres": "^3.4.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "dotenv": "^16.4.0",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.21.0"
    }
}
