# Application stack. Copy to .env.prod (git-ignored) and fill in.
#
# This is the container's whole environment: the image bakes in no secrets.
# The full list of variables the apps read lives in the repo-root .env.example
# — this file only adds what deployment itself needs.

# Set by the deploy to the git sha. There is no `latest`: a tag you cannot
# point at a commit is a tag you cannot roll back from.
IMAGE_TAG=
IMAGE_REPO=dns/client-api
ADMIN_IMAGE_REPO=dns/admin-api

# ── Ports ───────────────────────────────────────────────────────────────
# One number per service: the app binds it inside the container AND compose
# publishes it on 127.0.0.1 with the same number. nginx runs on the host, so
# loopback is how it reaches them.
#
# The defaults 3000/3001 collide with plenty of things on a shared box. Check
# before starting:
#   ss -ltnp | grep -E ':(3028|3029)\b'
#
# ⚠️ Changing these means changing prometheus/prometheus.yml too — Prometheus
# does not expand env vars in scrape targets. Miss it and the target reads
# DOWN, which fires dns-api-unscrapeable as if the service had crashed.
# The nginx proxy_pass in nginx/client-api.conf.example follows as well.
CLIENT_API_PORT=3028
ADMIN_API_PORT=3029

# ── Database, which lives OUTSIDE Docker ────────────────────────────────
# On the same host, reached through the extra_hosts entry in the compose file:
#   postgresql://dns:PASSWORD@host.docker.internal:5432/dns
# Managed or remote: its own hostname, and drop extra_hosts.
DATABASE_URL=

# ── Everything else the apps read ───────────────────────────────────────
# Copy the values from the repo-root .env.example and fill them in. The ones
# that matter most on a reachable server:
#
#   JWT_SECRET, ADMIN_JWT_SECRET, ADMIN_JWT_REFRESH_SECRET
#       — must not be the change-me literals.
#   OTP_DEV_CODE
#       — MUST be empty. Set, it makes the OTP service return that fixed code
#         instead of a generated one, for every email verification and every
#         password reset.
#   RESEND_API_KEY
#       — empty means the stub client logs the email instead of sending it,
#         so nobody can complete a sign-up.
#   S3_PUBLIC_URL
#       — must be reachable from a phone. Uploads go straight to storage,
#         bypassing the API, so a localhost value here fails on the device
#         with an opaque 403.
#   APPLE_PRIVATE_KEY / GOOGLE_SERVICE_ACCOUNT_JSON
#       — empty means the server accepts any invented purchase receipt as
#         real. Fine on a dev box, a free subscription for anyone in public.
