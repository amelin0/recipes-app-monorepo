{
    "uid": "dns-client-api",
    "title": "DNS · client-api",
    "description": "Request rate, latency and runtime health, with the matching logs underneath. Metrics and logs join on the `service` label — see prometheus.yml and promtail-config.yml.",
    "tags": ["dns", "client-api"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "templating": {
        "list": [
            {
                "name": "service",
                "type": "custom",
                "label": "Service",
                "query": "client-api",
                "current": { "text": "client-api", "value": "client-api" },
                "options": [{ "text": "client-api", "value": "client-api", "selected": true }]
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Ready",
            "description": "probe_success from the blackbox probe of /api/v1/health/ready. `up` would say yes with a dead database.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
                        { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
                    ],
                    "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "probe_success{job=\"blackbox-ready\", service=\"$service\"}",
                    "legendFormat": "ready"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Requests / s",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_request_duration_seconds_count{service=\"$service\"}[5m]))",
                    "legendFormat": "rps"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "5xx share",
            "description": "Server errors as a fraction of all responses. 4xx are excluded on purpose — a client sending bad input is not an outage.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "orange", "value": 0.01 },
                            { "color": "red", "value": 0.05 }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_request_duration_seconds_count{service=\"$service\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count{service=\"$service\"}[5m])), 0.001)",
                    "legendFormat": "5xx"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "p95 latency",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
                    "legendFormat": "p95"
                }
            ]
        },
        {
            "id": 5,
            "type": "stat",
            "title": "Heap used",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "nodejs_heap_size_used_bytes{service=\"$service\"}",
                    "legendFormat": "heap"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Requests by status",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (status) (rate(http_request_duration_seconds_count{service=\"$service\"}[5m]))",
                    "legendFormat": "{{status}}"
                }
            ]
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "p95 latency by route",
            "description": "Route is the Express pattern, never the raw URL — unmatched requests all land in <unmatched>.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m]))))",
                    "legendFormat": "{{route}}"
                }
            ]
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Event loop lag (p99)",
            "description": "How late a timer fires. It rises before latency does, which makes it the earliest warning this stack has.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 7, "w": 8, "x": 0, "y": 12 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "nodejs_eventloop_lag_p99_seconds{service=\"$service\"}",
                    "legendFormat": "p99"
                }
            ]
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Memory",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 7, "w": 8, "x": 8, "y": 12 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "process_resident_memory_bytes{service=\"$service\"}",
                    "legendFormat": "rss"
                },
                {
                    "refId": "B",
                    "expr": "nodejs_heap_size_used_bytes{service=\"$service\"}",
                    "legendFormat": "heap used"
                }
            ]
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Host: disk free on /",
            "description": "Loki chunks and Postgres share this disk. When it fills, Postgres is what stops first.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 7, "w": 8, "x": 16, "y": 12 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "node_filesystem_avail_bytes{mountpoint=\"/rootfs\", fstype!~\"tmpfs|overlay\"}",
                    "legendFormat": "{{mountpoint}}"
                }
            ]
        },
        {
            "id": 11,
            "type": "logs",
            "title": "Errors and warnings",
            "description": "Same `service` label as the metrics above, which is what makes a spike and its cause line up.",
            "datasource": { "type": "loki", "uid": "loki" },
            "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
            "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "{service=\"$service\", level=~\"warn|error|fatal\"}",
                    "queryType": "range"
                }
            ]
        }
    ]
}
