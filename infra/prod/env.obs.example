# Observability stack. Copy to .env.obs (git-ignored) and fill in.
#
#   cp env.obs.example .env.obs
#   docker compose -p dns-obs --env-file .env.obs -f docker-compose.obs.yml up -d
#
# --env-file is required on EVERY command against this stack, `ps` and `logs`
# included: compose auto-loads only a file literally named `.env`.

# Must match the public URL nginx serves Grafana on, or OAuth redirects and
# generated links point at localhost.
GRAFANA_ROOT_URL=https://grafana.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Telegram alerting ───────────────────────────────────────────────────
# 1. @BotFather → /newbot → it hands you the token.
# 2. Add the bot to the group, send any message there, then:
#      curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#    and read message.chat.id — negative for a group.
#
# ⚠️ Only the TOKEN goes here. The chat id lives INLINE in
# grafana/provisioning/alerting/contact-points.yml, because Grafana re-types
# a substituted value and a negative number crashes provisioning
# (grafana/grafana#69950) — which takes all of Grafana down, not just alerts.
TELEGRAM_BOT_TOKEN=
