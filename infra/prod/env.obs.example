# Observability stack. Copy to .env.obs (git-ignored) and fill in.
#
#   cp env.obs.example .env.obs
#   docker compose -p dns-obs --env-file .env.obs -f docker-compose.obs.yml up -d
#
# --env-file is required on EVERY command against this stack, `ps` and `logs`
# included: compose auto-loads only a file literally named `.env`.

# Must match the public URL nginx serves Grafana on, or OAuth redirects and
# generated links point at localhost.
GRAFANA_ROOT_URL=https://grafana.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
