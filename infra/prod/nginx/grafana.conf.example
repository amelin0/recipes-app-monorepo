# Grafana vhost. Grafana is published on 127.0.0.1 only; nginx runs on the
# host, so this is the one way in.
#
# There is deliberately no vhost for Prometheus: it has no authentication at
# all. Reach it with `ssh -L 9090:127.0.0.1:${PROMETHEUS_HTTP_PORT} <host>`,
# or from Grafana's Explore.

server {
    listen 80;
    server_name grafana.example.com;

    location / {
        # Must equal GRAFANA_HTTP_PORT in .env.obs.
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Grafana Live (dashboard streaming) is websockets.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
