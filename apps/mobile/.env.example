# Copy to `.env` and fill values. `.env` is gitignored.
#
# Only variables prefixed with `EXPO_PUBLIC_` are exposed to the JS bundle at
# runtime. Anything else is build-time only (and inlined by Metro during
# prebuild / EAS build).

# Base URL for the DNS REST API. Include the `/api/v1` version segment.
# Local dev: http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
